{
  "name": "medbox",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "日常工具箱：吃药提醒 + 工时记录 (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && node scripts/package-dist.mjs",
    "preview": "vite preview --host",
    "deploy:pages": "wrangler pages deploy dist --project-name=medbox-pwa --commit-dirty=true",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run cap:sync && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@cloudflare/workers-types": "^4.20260607.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "wrangler": "^4.98.0"
  }
}
