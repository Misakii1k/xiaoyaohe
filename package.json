{
  "name": "medbox",
  "version": "0.7.6",
  "private": true,
  "type": "module",
  "description": "日常工具箱：吃药提醒 + 工时记录 (PWA)",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:release": "vitest run tests/release-utils.test.ts",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:web",
    "package": "npm run build && node scripts/package-dist.mjs",
    "release": "node scripts/release.mjs",
    "preview": "vite preview --host",
    "deploy:pages": "wrangler pages deploy dist --project-name=medbox-pwa --commit-dirty=true",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run cap:sync && node scripts/android-debug.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.0",
    "lucide": "1.24.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@cloudflare/workers-types": "^5.20260713.1",
    "@playwright/test": "^1.61.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.110.0"
  }
}
