{
  "name": "xiaoyaohe",
  "version": "1.0.8",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "小药盒：吃药提醒、药品管理与库存记录 Android App",
  "scripts": {
    "dev": "vite",
    "assets:build": "node scripts/gen-icons.mjs",
    "assets:check": "node scripts/gen-icons.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "vitest run tests/release-utils.test.ts",
    "bundle:web": "node scripts/bundle-web.mjs",
    "build:web": "node scripts/gen-version.mjs && npm run assets:check && vite build && node scripts/bundle-web.mjs && node scripts/gen-version.mjs",
    "build": "npm run typecheck && npm run build:web",
    "release": "node scripts/release.mjs",
    "preview": "vite preview --host",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run cap:sync && node scripts/android-debug.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/core": "^2.1.1",
    "@tabler/icons": "^3.45.0",
    "dompurify": "^3.4.12",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.0",
    "marked": "^18.0.6",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.61.1",
    "@types/qrcode": "^1.5.6",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "jpeg-js": "^0.4.4",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.0"
  }
}
