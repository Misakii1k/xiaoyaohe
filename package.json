{
  "name": "medbox",
  "version": "0.7.7",
  "private": true,
  "type": "module",
  "description": "日常工具箱：吃药提醒 + 工时记录 Android App",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "vitest run tests/release-utils.test.ts",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:web",
    "release": "node scripts/release.mjs",
    "preview": "vite preview --host",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run cap:sync && node scripts/android-debug.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "dompurify": "^3.4.12",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.0",
    "lucide": "1.24.0",
    "marked": "^18.0.6",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.61.1",
    "@types/qrcode": "^1.5.6",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.0"
  }
}
