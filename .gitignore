# 依赖
node_modules/

# 构建产物与发布目录（APK/zip/校验和均不入库）
dist/
dev-dist/
release/
# 由 scripts/gen-version.mjs 在构建时生成：入库会造成「构建即脏工作区」
# 且已提交值与线上值不一致（曾出现 32095374 与 16398223 并存）
public/version.json

# Cloudflare / Wrangler 本地状态
.wrangler/

# Claude Code 工程元数据
.claude/

# 本地日志
*.log
preview.log

# 编辑器 / 系统
.DS_Store
Thumbs.db
.vscode/
.idea/
.trae/*
!.trae/specs/
!.trae/specs/**

# 环境变量与密钥（绝对不能提交）
.env
.env.*
!.env.example
!.env.production

# 临时与缓存
*.tmp
.cache/
tmp/imagegen/

# 图标/视觉迭代的调试残留（下划线前缀脚本与截图）
scripts/_*
design/brand/master/_*
test-cn-text.png

# Browser-test sessions, screenshots, traces, and reports
.playwright-cli/
output/
playwright-report/
test-results/

# 本地 UI 预览截图
screenshots/

# IDE / 审计缓存
.mimosa/
